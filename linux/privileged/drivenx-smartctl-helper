#!/usr/bin/python3 -I
"""DriveNX Linux SMART broker. Installed root-owned; no shell, network, or arbitrary commands."""
import json
import os
import re
import selectors
import stat
import subprocess
import sys
import time

SMARTCTL = ('/usr/sbin/smartctl', '/usr/bin/smartctl', '/sbin/smartctl', '/bin/smartctl')
TYPE = re.compile(r'^(?:[a-zA-Z0-9][a-zA-Z0-9,+_-]{0,59}|snt(?:jmicron|asmedia|realtek)/sat)$')
DEVICE = re.compile(r'^/dev/[a-zA-Z0-9_/.+:-]{1,230}$')
MAX_BYTES = 4 * 1024 * 1024
MAX_LINE = 4096


def valid_args(args):
    if not isinstance(args, list) or not all(isinstance(v, str) for v in args):
        return False
    if args == ['--scan-open', '-j']:
        return True
    if len(args) == 5 and args[0] in ('-a', '-x', '-i') and args[1:3] == ['-j', '-d']:
        return valid_device_args(args[3], args[4])
    if (len(args) == 6 and args[0] == '-t' and args[1] in ('short', 'long')
            and args[2:4] == ['-j', '-d']):
        return valid_device_args(args[4], args[5])
    return False


def valid_device_args(kind, device):
    if not TYPE.fullmatch(kind) or not DEVICE.fullmatch(device):
        return False
    if '..' in device.split('/') or '//' in device:
        return False
    try:
        info = os.stat(device)
        return stat.S_ISBLK(info.st_mode) or stat.S_ISCHR(info.st_mode)
    except OSError:
        return False


def trusted_smartctl():
    for filename in SMARTCTL:
        try:
            real = os.path.realpath(filename)
            if not real.startswith('/usr/'):
                continue
            current = real
            while True:
                s = os.stat(current)
                if s.st_uid != 0 or s.st_mode & 0o022:
                    raise ValueError('untrusted ownership')
                if current == real and (not stat.S_ISREG(s.st_mode) or not s.st_mode & 0o111):
                    raise ValueError('not executable')
                if current != real and not stat.S_ISDIR(s.st_mode):
                    raise ValueError('not a directory')
                if current == '/':
                    break
                current = os.path.dirname(current)
            return real
        except (OSError, ValueError):
            pass
    raise RuntimeError('trusted smartctl not found')


def run_bounded(binary, args, timeout):
    process = subprocess.Popen([binary, *args], stdin=subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                               close_fds=True, env={'LC_ALL': 'C', 'PATH': '/usr/bin:/bin'})
    selector = selectors.DefaultSelector()
    stdout, stderr = bytearray(), bytearray()
    selector.register(process.stdout, selectors.EVENT_READ, stdout)
    selector.register(process.stderr, selectors.EVENT_READ, stderr)
    deadline = time.monotonic() + timeout
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError('smartctl timed out')
            ready = selector.select(remaining)
            if not ready:
                raise TimeoutError('smartctl timed out')
            for key, _ in ready:
                chunk = os.read(key.fileobj.fileno(), 65536)
                if not chunk:
                    selector.unregister(key.fileobj)
                    key.fileobj.close()
                    continue
                key.data.extend(chunk)
                if len(stdout) + len(stderr) > MAX_BYTES:
                    raise ValueError('smartctl output too large')
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError('smartctl timed out')
        code = process.wait(timeout=remaining)
        return {'stdout': stdout.decode('utf-8', 'replace'),
                'stderr': stderr.decode('utf-8', 'replace'), 'exitCode': code}
    except (TimeoutError, ValueError, subprocess.TimeoutExpired):
        process.kill()
        process.wait()
        raise
    finally:
        selector.close()
        for stream in (process.stdout, process.stderr):
            if not stream.closed:
                stream.close()


def main():
    if os.geteuid() != 0 or 'PKEXEC_UID' not in os.environ:
        return 1
    try:
        binary = trusted_smartctl()
    except RuntimeError:
        return 1
    # The helper lives only while its parent's stdin pipe remains open.
    while True:
        line = sys.stdin.buffer.readline(MAX_LINE + 1)
        if not line:
            return 0
        if len(line) > MAX_LINE or not line.endswith(b'\n'):
            return 1
        request = None
        try:
            request = json.loads(line)
            if (not isinstance(request, dict) or type(request.get('id')) is not int
                    or not 0 <= request['id'] < 2**32 or not valid_args(request.get('args'))):
                raise ValueError('invalid request')
            timeout = request.get('timeout')
            if type(timeout) is not int or not 1 <= timeout <= 70:
                raise ValueError('invalid timeout')
            result = run_bounded(binary, request['args'], timeout)
            response = {'id': request['id'], **result}
        except Exception as error:
            # No tracebacks / environment / device data in the broker response.
            response = {'id': request.get('id', -1) if isinstance(request, dict) else -1,
                        'error': str(error)[:200]}
        sys.stdout.write(json.dumps(response, ensure_ascii=True, separators=(',', ':')) + '\n')
        sys.stdout.flush()


if __name__ == '__main__':
    sys.exit(main())
